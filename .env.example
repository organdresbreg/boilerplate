# Application Settings
APP_NAME="FullStack Boilerplate 2026"
ENVIRONMENT="development"
# SECRET_KEY: dejar vacío para generación automática, o definir uno personalizado
SECRET_KEY=""
DEBUG=True

# Database Configuration (SQLite - no external DB required)
SQLITE_DB_PATH="./app.db"
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# Backend API
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# CORS: formato JSON o comma-separated (ej: '["https://dominio.com"]' o "https://dominio1.com,https://dominio2.com")
BACKEND_CORS_ORIGINS_RAW='["http://localhost:5173"]'

# Producción: deshabilitar docs (/docs, /redoc, /openapi.json)
DISABLE_DOCS=False

# Frontend
FRONTEND_PORT=5173
VITE_API_URL="http://localhost:8000"
