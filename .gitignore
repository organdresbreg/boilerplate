```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map
*.jsx.map
*.tsx.map

# Environment variables
.env
.env.local
*.env
*.env.*

# Logs
*.log

# Coverage reports
coverage/
.nyc_output/
istanbul/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python artifacts (if any Python files exist in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Temporary files
*.tmp
*.temp
*.bak

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
```